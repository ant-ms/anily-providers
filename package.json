{
  "name": "@ant.ms/anily-providers",
  "version": "1.0.0",
  "description": "High-reliability anime streaming provider resolvers, scrapers, and stream quality verifiers for Anily",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ant-ms/anily-providers.git"
  },
  "bugs": {
    "url": "https://github.com/ant-ms/anily-providers/issues"
  },
  "homepage": "https://github.com/ant-ms/anily-providers#readme",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "anime",
    "streaming",
    "providers",
    "anily",
    "scrapers",
    "hls"
  ],
  "license": "MIT",
  "author": "Yanik Ammann <yanik@ant.ms>",
  "dependencies": {
    "cheerio": "^1.2.0",
    "html-entities": "^2.6.0",
    "lru-cache": "^11.5.3",
    "m3u8-parser": "^7.2.0"
  },
  "devDependencies": {
    "@types/m3u8-parser": "^7.2.6",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "prettier": "^3.8.3",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
